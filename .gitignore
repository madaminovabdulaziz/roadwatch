# Python
__pycache__/
*.py[cod]
.venv/
.venv-export/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data and generated outputs (never commit videos or caches)
samples/
cache/
outputs/
*.parquet
*.mp4
*.MP4
*.mov
sheets.zip
web/teamdata/
# ...except the short annotated renders the website serves (scripts/render_samples.py, 720p H.264)
!web/public/data/**/*.mp4
predictions.json
predictions_dev*.json
report*.json
# ...except the website's report page (web/public/data/report.json)
!web/public/data/report.json
configs/*.bak
configs/*.tmp

# Model weights: the two files the detector loads are committed (81 MB, under GitHub's 100 MB limit), so
# the organizers' two commands need nothing else; weights/download.sh re-fetches them from the release
weights/*
!weights/download.sh
!weights/README.md
!weights/SHA256SUMS
!weights/yolo11m.torchscript
!weights/yolo11m.json

# OS / editors
.DS_Store
.idea/
.vscode/
