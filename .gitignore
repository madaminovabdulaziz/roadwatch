# Python
__pycache__/
*.py[cod]
.venv/
.venv-export/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data and generated outputs (never commit videos or caches)
samples/
cache/
outputs/
*.parquet
*.mp4
*.MP4
*.mov
# ...except the short annotated renders the website serves (scripts/render_samples.py, 720p H.264)
!web/public/data/**/*.mp4
predictions.json
predictions_dev*.json
report*.json
# ...except the website's report page (web/public/data/report.json)
!web/public/data/report.json
configs/*.bak
configs/*.tmp

# Model weights live in the release archive fetched by weights/download.sh
weights/*
!weights/download.sh
!weights/README.md
!weights/SHA256SUMS

# OS / editors
.DS_Store
.idea/
.vscode/
